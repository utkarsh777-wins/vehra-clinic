# Assistant. "none" uses the built-in FAQ matcher and scripted booking flow.
# Other values: openai | groq | gemini | openrouter
LLM_PROVIDER=none
LLM_API_KEY=
# Optional. Defaults: openai gpt-4o-mini, groq llama-3.3-70b-versatile,
# gemini gemini-2.0-flash, openrouter openai/gpt-4o-mini
LLM_MODEL=

# Opt-in only. When unset, appointment requests are stored locally and sent nowhere.
# See README for the Apps Script webhook.
BOOKING_WEBHOOK_URL=

# JSON file for appointment requests.
# Local default: data/bookings.json
# On Vercel the default is /tmp/vehra-bookings.json (ephemeral).
BOOKINGS_STORE_PATH=

# Shared secret for GET /api/bookings and the /bookings page.
BOOKINGS_VIEW_SECRET=change-me

# Digits only, country code included, no plus sign. Placeholder until you set a real number.
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
